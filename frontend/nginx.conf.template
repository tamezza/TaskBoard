server {
    listen 8080;
    root /usr/share/nginx/html;

    # Same rule as the Vite dev proxy: /api/boards -> <API_URL>/boards
    # ${API_URL} is replaced by the value of the environment variable
    # when the container starts, so one image works in every environment.
    location /api/ {
        proxy_pass ${API_URL}/;
    }

    # Everything else is the React application
    location / {
        try_files $uri /index.html;
    }
}
